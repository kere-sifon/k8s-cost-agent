# Shared by admin-ui and mcp-server — must match in both processes.
K8S_COST_AGENT_DB_PATH=./data/clusters.db

# Admin UI bind address (localhost-only by default — deliberate, see README)
ADMIN_UI_HOST=127.0.0.1
ADMIN_UI_PORT=8082

# AWS Bedrock (Claude Haiku via boto3 Converse)
AWS_REGION=us-east-1
AWS_PROFILE=default
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_MAX_TOKENS=4096
BEDROCK_TEMPERATURE=0
